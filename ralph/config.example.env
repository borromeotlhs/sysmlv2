# Copy this file to ralph/config.env and edit as needed.

# Max repair cycles.
RALPH_MAX_ITERS=12

# Claude Code model alias or full model name if your setup requires it.
RALPH_MODEL=sonnet

# Permission mode options vary by Claude Code version.
# Safer default:
RALPH_PERMISSION_MODE=acceptEdits

# Use this if your workplace explicitly approves broader automation.
# RALPH_PERMISSION_MODE=bypassPermissions

# Main task prompt.
RALPH_TASK_FILE=tasks/mega_task.md

# Check command. This is the judge.
RALPH_CHECK_CMD="./ralph/run_mvp_checks.sh"

# Allowlist for Claude tools.
# Keep Bash limited via .claude/settings.json deny rules.
RALPH_ALLOWED_TOOLS="Read,Write,Edit,MultiEdit,Glob,Grep,Bash,Task"

# Optional disallowed tools CLI string. Project settings also deny risky Bash patterns.
RALPH_DISALLOWED_TOOLS=""

# If set to 1, prints each prompt file before calling Claude.
RALPH_VERBOSE=0
